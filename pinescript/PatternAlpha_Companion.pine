//@version=6
indicator("PatternAlpha Companion", overlay=true)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi14 = ta.rsi(close, 14)
plot(ema20, "EMA 20", linewidth=2)
plot(ema50, "EMA 50", linewidth=2)
plot(ema200, "EMA 200", linewidth=2)
bullCross = ta.crossover(ema20, ema50)
bearCross = ta.crossunder(ema20, ema50)
plotshape(bullCross, title="Bullish EMA Cross", style=shape.triangleup, location=location.belowbar, size=size.small, text="EMA+")
plotshape(bearCross, title="Bearish EMA Cross", style=shape.triangledown, location=location.abovebar, size=size.small, text="EMA-")
bgcolor(ema20 > ema50 and ema50 > ema200 ? color.new(color.green, 92) : ema20 < ema50 and ema50 < ema200 ? color.new(color.red, 92) : na)
alertcondition(bullCross, title="PatternAlpha Bullish EMA Cross", message="PatternAlpha: EMA20 crossed above EMA50 on {{ticker}} at {{close}}")
alertcondition(bearCross, title="PatternAlpha Bearish EMA Cross", message="PatternAlpha: EMA20 crossed below EMA50 on {{ticker}} at {{close}}")
plot(rsi14, "RSI 14 (Data Window)", display=display.data_window)
